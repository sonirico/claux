{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux set-window-option -t \"$TMUX_PANE\" @agent_state idle 2>/dev/null; true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && command -v jq >/dev/null 2>&1 && tp=$(jq -r \".transcript_path // empty\" 2>/dev/null) && [ -n \"$tp\" ] && tmux set-window-option -t \"$TMUX_PANE\" @agent_transcript \"$tp\" 2>/dev/null; true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux set-window-option -t \"$TMUX_PANE\" @agent_pane \"$TMUX_PANE\" 2>/dev/null; true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux set-window-option -t \"$TMUX_PANE\" @agent_state working 2>/dev/null; true"
          },
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && command -v jq >/dev/null 2>&1 && tp=$(jq -r \".transcript_path // empty\" 2>/dev/null) && [ -n \"$tp\" ] && tmux set-window-option -t \"$TMUX_PANE\" @agent_transcript \"$tp\" 2>/dev/null; true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux set-window-option -t \"$TMUX_PANE\" @agent_pane \"$TMUX_PANE\" 2>/dev/null; true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux set-window-option -t \"$TMUX_PANE\" @agent_state waiting 2>/dev/null; true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux set-window-option -t \"$TMUX_PANE\" @agent_state working 2>/dev/null; true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux set-window-option -t \"$TMUX_PANE\" @agent_state waiting 2>/dev/null; true"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && [ \"$(tmux show-window-option -v -t \"$TMUX_PANE\" @agent_state 2>/dev/null)\" = working ] && tmux set-window-option -t \"$TMUX_PANE\" @agent_state idle 2>/dev/null; true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux set-window-option -t \"$TMUX_PANE\" @agent_state waiting 2>/dev/null; true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux set-window-option -t \"$TMUX_PANE\" @agent_state done 2>/dev/null; true"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux set-window-option -t \"$TMUX_PANE\" @agent_state error 2>/dev/null; true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && { tmux set-window-option -t \"$TMUX_PANE\" @agent_prev_state \"$(tmux show-window-option -v -t \"$TMUX_PANE\" @agent_state 2>/dev/null)\" 2>/dev/null; tmux set-window-option -t \"$TMUX_PANE\" @agent_state compacting 2>/dev/null; }; true"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && { s=$(tmux show-window-option -v -t \"$TMUX_PANE\" @agent_prev_state 2>/dev/null); tmux set-window-option -t \"$TMUX_PANE\" @agent_state \"${s:-idle}\" 2>/dev/null; }; true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && { tmux set-window-option -t \"$TMUX_PANE\" -u @agent_state 2>/dev/null; tmux set-window-option -t \"$TMUX_PANE\" -u @agent_ctx 2>/dev/null; tmux set-window-option -t \"$TMUX_PANE\" -u @agent_transcript 2>/dev/null; tmux set-window-option -t \"$TMUX_PANE\" -u @agent_pane 2>/dev/null; tmux set-window-option -t \"$TMUX_PANE\" -u @agent_prev_state 2>/dev/null; }; true"
          }
        ]
      }
    ]
  }
}
